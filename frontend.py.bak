# frontend.py
"""
Chronicle Engine - Textual Frontend
A terminal-based AI RPG client using Textual and WebSockets.
Handles all structured events from the Pydantic AI backend.
"""
from textual.app import App, ComposeResult
from textual.containers import Container, ScrollableContainer
from textual.widgets import Header, Input, Static, RichLog
import json
import logging
import traceback
import websockets
import asyncio
from datetime import datetime
from pathlib import Path

# Ensure log directory exists
log_dir = Path(".spy_console")
log_dir.mkdir(exist_ok=True)
log_file = log_dir / "spy_cli_debug.log"

# Configure logging
logging.basicConfig(
    level=logging.DEBUG,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler(log_file, mode='a')
        # StreamHandler removed to prevent console output
    ]
)
logger = logging.getLogger("spy_frontend")
logger.info("=== Starting Chronicle Engine Frontend ===")


class MessageLog(Static, can_focus=False):
    """Widget to display the message log with rich formatting."""
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        # Simple non-reactive storage
        self.messages_list = []  # Raw messages
        self.text_log = None     # RichLog reference
        self._composed = False   # Flag to prevent multiple widget creation
        logger.debug("[UI] MessageLog.__init__: initialized with empty messages list")
    
    def compose(self) -> ComposeResult:
        """Create child widgets."""
        logger.debug("[UI] MessageLog.compose called")
        
        # Only create the RichLog once
        if not self._composed:
            logger.debug("[UI] Creating RichLog widget in MessageLog.compose")
            with ScrollableContainer(id="log-container"):
                rich_log = RichLog(id="log-content")
                yield rich_log
                self.text_log = rich_log
                logger.debug(f"[UI] Created RichLog widget: {self.text_log!r}")
            self._composed = True
    
    def on_mount(self) -> None:
        """Called when the widget is mounted."""
        logger.debug("[UI] MessageLog mounted")
        # Update display if we have messages
        if self.messages_list:
            self.update_display()
    
    def _format_message(self, msg: dict) -> str:
        """Format a message for display."""
        try:
            msg_type = msg.get("type", "unknown")
            content = str(msg.get("content", msg.get("text", "")))  # Fallback to text field
            
            if msg_type == 'system':
                return f"SYSTEM: {content}\n\n"
            elif msg_type == 'user':
                return f"YOU: {content}\n\n"
            elif msg_type == 'narrative':
                return f"NARRATIVE: {content}\n\n"
            elif msg_type == 'choice':
                options = msg.get('options', [])
                result = "CHOICES:\n"
                for i, option in enumerate(options, 1):
                    result += f"{i}. {option}\n"
                return result + "\n"
            elif msg_type == 'error':
                return f"ERROR: {content}\n\n"
            else:
                return f"{msg_type.upper()}: {content}\n\n"
        except Exception as e:
            logger.error(f"[UI] Error formatting message: {e}")
            return f"ERROR: Could not format message: {str(e)}\n\n"
    
    def update_display(self) -> None:
        """Update the message display with current messages."""
        try:
            logger.debug(f"[UI] Updating display with {len(self.messages_list)} messages")
            
            # Ensure we have a text log
            if self.text_log is None:
                logger.error("[UI] No text_log available for display update")
                return
                
            # Clear the log
            self.text_log.clear()
            logger.debug("[UI] Cleared RichLog content")
            
            # Format and display each message
            for i, msg in enumerate(self.messages_list, start=1):
                formatted = self._format_message(msg)
                if formatted:
                    logger.debug(f"[UI] Writing message {i}: {formatted[:50]}...")
                    self.text_log.write(formatted)
                    if i < len(self.messages_list):
                        self.text_log.write("\n\n")  # Double newline for spacing
            
            # Refresh and scroll
            self.text_log.refresh()
            self.text_log.scroll_end(animate=False)
            logger.debug(f"[UI] Display updated with {len(self.messages_list)} messages")
            
        except Exception as e:
            logger.error(f"[UI] Error updating display: {e}\n{traceback.format_exc()}")
    
    def add_message(self, event: dict) -> None:
        """Add a message to the log."""
        try:
            if not isinstance(event, dict):
                logger.warning(f"Expected dict, got {type(event).__name__}")
                event = {"type": "error", "content": f"Invalid message format: {event}"}
            
            # Ensure we have a valid message type
            if "type" not in event:
                event["type"] = "system"
                
            # Ensure we have content
            if "content" not in event:
                if "text" in event:
                    event["content"] = event["text"]
                else:
                    # Create content from other fields
                    content = ""
                    for field in ["message", "description", "output"]:
                        if field in event and event[field]:
                            content = str(event[field])
                            break
                    
                    if not content:
                        # Create content from all non-metadata fields
                        content = ", ".join(
                            f"{k}: {v}" for k, v in event.items() 
                            if k not in ["type", "timestamp"] and not k.startswith("_")
                        )
                    
                    event["content"] = content or "[No content]"
                
            # Ensure we have a timestamp
            if "timestamp" not in event:
                event["timestamp"] = datetime.now().isoformat()
            
            # Add to messages list
            self.messages_list.append(event)
            
            # Update the display
            self.update_display()
            
            msg_type = event.get("type", "unknown")
            content_preview = str(event.get("content", ""))[:100]
            logger.debug(f"Added message (type: {msg_type}): {content_preview}...")
            
        except Exception as e:
            logger.error(f"Error adding message: {e}", exc_info=True)
            # Add error to messages
            error_msg = {
                "type": "error",
                "content": f"Error displaying message: {str(e)}",
                "timestamp": datetime.now().isoformat()
            }
            self.messages_list.append(error_msg)
            self.update_display()
    
    def clear_messages(self) -> None:
        """Clear all messages from the log."""
        self.messages_list = []
        if self.text_log:
            self.text_log.clear()
            
    def render(self) -> str:
        """Render the message log content."""
        return ""  # The actual content is in the RichLog widget
    
    DEFAULT_CSS = """
    MessageLog {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
    RichLog {
        background: #000000; /* Black background instead of transparent */
        padding: 1;
        color: #00ff00; /* Explicitly set text color to green */
        content-align: left top;
    }
    .visible-text {
        color: #00ff00 !important;
        background: #000000 !important;
        text-opacity: 1.0 !important;
    }
    """

    # Removed duplicate compose method
                # Create the RichLog widget with explicit styling to ensure visibility
                rich_log = RichLog(
                    highlight=True, 
                    markup=True,
                    id="log-content",
                    classes="visible-text"
                )
                yield rich_log
                self._text_log = rich_log
                logger.debug(f"[UI] Created RichLog widget in compose: {self._text_log!r}")
            # Mark as composed to prevent multiple creations
            self._composed = True

    def watch_messages(self) -> None:
        """Re-render the log when messages change."""
        logger.debug(f"watch_messages: {len(self.messages)} messages in log")
        
        # Always ensure _formatted_messages is a list
        if not hasattr(self, '_formatted_messages') or not isinstance(self._formatted_messages, list):
            logger.error(f"[UI] In watch_messages: _formatted_messages is not a list: {type(self._formatted_messages)}")
            object.__setattr__(self, '_formatted_messages', [])
            
        logger.debug(f"[UI] _formatted_messages type: {type(self._formatted_messages)}, value: {self._formatted_messages}")
        
        # If no messages, just clear the content
        if not self.messages:
            if self._text_log:
                self._text_log.clear()
            return
        
        # Always update the content when messages change
        self._update_content()
            
    def _format_message(self, msg: dict) -> str:
        """Format a single message for display with enhanced styling."""
        logger.debug(f"Formatting message: {msg}")
        if not isinstance(msg, dict):
            return str(msg)
        
        # Extract message content and type
        content = msg.get('text', msg.get('content', ''))
        msg_type = msg.get('type', 'unknown')
        
        # ULTRA SIMPLE FORMATTING - just use plain text with minimal markup
        # This ensures maximum compatibility and visibility
        if msg_type == 'system':
            return f"SYSTEM: {content}\n\n"
        elif msg_type == 'user':
            return f"YOU: {content}\n\n"
        elif msg_type == 'narrative':
            return f"NARRATIVE: {content}\n\n"
        elif msg_type == 'choice':
            options = msg.get('options', [])
            result = "CHOICES:\n"
            for i, option in enumerate(options, 1):
                result += f"{i}. {option}\n"
            return result + "\n"
        elif msg_type == 'error':
            return f"ERROR: {content}\n\n"
        else:
            return f"{msg_type.upper()}: {content}\n\n"
        
    def _update_content(self) -> None:
        """Update the message log content with detailed logging."""
        try:
            logger.debug(f"[UI] _update_content: Starting update for {len(self.messages)} total messages")
            
            # Always ensure we have a valid list for _formatted_messages
            # This is critical to prevent the 'bool' object has no attribute 'append' error
            if not hasattr(self, '_formatted_messages') or not isinstance(self._formatted_messages, list):
                logger.error(f"[UI] _formatted_messages is missing or not a list: {getattr(self, '_formatted_messages', 'MISSING')}")
                # Use direct attribute assignment to avoid any property issues
                object.__setattr__(self, '_formatted_messages', [])
            
            # Use the existing RichLog widget - don't create a new one
            if self._text_log is None:
                logger.error("[UI] RichLog widget not initialized, this should not happen!")
                # Only try to find the existing widget, don't create a new one
                try:
                    self._text_log = self.query_one(RichLog)
                    logger.debug(f"[UI] Found RichLog widget by query: {self._text_log!r}")
                except Exception:
                    logger.debug("[UI] Could not find RichLog by query, searching children...")
                    for child in self.children:
                        if isinstance(child, ScrollableContainer):
                            for grandchild in child.children:
                                if isinstance(grandchild, RichLog):
                                    self._text_log = grandchild
                                    logger.debug(f"[UI] Found RichLog in children: {self._text_log!r}")
                                    break
                    if self._text_log is None:
                        logger.error("[UI] Could not find RichLog widget! Messages will not be displayed.")
                        return
            
            # Log RichLog widget properties for debugging
            try:
                logger.debug(f"[UI] RichLog widget details: id={self._text_log.id}, classes={self._text_log.classes}")
                logger.debug(f"[UI] RichLog background color: {self._text_log.styles.background}")
                logger.debug(f"[UI] RichLog text color: {self._text_log.styles.color}")
                logger.debug(f"[UI] RichLog parent: {self._text_log.parent.__class__.__name__ if self._text_log.parent else 'None'}")
                logger.debug(f"[UI] RichLog is visible: {self._text_log.visible}")
                logger.debug(f"[UI] RichLog display: {self._text_log.styles.display}")
                logger.debug(f"[UI] RichLog opacity: {self._text_log.styles.opacity}")
                logger.debug(f"[UI] RichLog size: width={self._text_log.size.width}, height={self._text_log.size.height}")
                logger.debug(f"[UI] RichLog content size: {len(self._text_log.document.text)}")
                logger.debug(f"[UI] RichLog has content: {'Yes' if self._text_log.document.text else 'No'}")
                logger.debug(f"[UI] RichLog first 50 chars: {self._text_log.document.text[:50] if self._text_log.document.text else 'Empty'}")
            except Exception as e:
                logger.error(f"[UI] Error getting RichLog properties: {str(e)}")
                
            # Format any new messages
            new_messages_count = 0
            logger.debug(f"[UI] Before formatting: _formatted_messages type: {type(self._formatted_messages)}")
            
            # Extra safety check
            if not isinstance(self._formatted_messages, list):
                logger.error(f"[UI] _formatted_messages is still not a list but {type(self._formatted_messages)}, resetting again")
                self._formatted_messages = []
                
            # Check if we can safely slice self.messages
            try:
                messages_to_format = self.messages[len(self._formatted_messages):]
                logger.debug(f"[UI] Will format {len(messages_to_format)} new messages")
            except Exception as slice_err:
                logger.error(f"[UI] Error slicing messages: {slice_err}")
                messages_to_format = list(self.messages)  # Use all messages as fallback
                self._formatted_messages = []  # Reset formatted messages
                logger.debug(f"[UI] Reset and will format all {len(messages_to_format)} messages")
                
            for i, msg in enumerate(messages_to_format, start=len(self._formatted_messages)):
                try:
                    formatted = self._format_message(msg)
                    if formatted:  # Skip empty strings (like typing indicators)
                        self._formatted_messages.append(formatted)
                        new_messages_count += 1
                        logger.debug(f"[UI] Message {i+1} formatted successfully (length: {len(formatted)} chars)")
                    else:
                        logger.debug(f"[UI] Message {i+1} filtered out (empty after formatting)")
                except Exception as format_err:
                    logger.error(f"[UI] Error formatting message {i+1}: {str(format_err)}")
                    logger.error(traceback.format_exc())
            
            logger.debug(f"[UI] Message processing: {new_messages_count} new messages (total: {len(self.messages)}, cached: {len(self._formatted_messages)})")
            
            # Clear the RichLog to avoid duplicates
            try:
                self._text_log.clear()
                logger.debug("[UI] Cleared RichLog content")
            except Exception as clear_err:
                logger.error(f"[UI] Error clearing RichLog: {str(clear_err)}")
                
            # Write all formatted messages to the log with explicit debug output
            try:
                for i, msg in enumerate(self._formatted_messages, start=1):
                    # Add debug message to verify content is being written
                    logger.debug(f"[UI] Writing message {i}: {msg[:50]}...")
                    self._text_log.write(msg)
                    if i < len(self._formatted_messages):
                        self._text_log.write("\n\n")  # Double newline for spacing
                    logger.debug(f"[UI] Successfully wrote message {i}/{len(self._formatted_messages)} to RichLog")
                
                # Force a refresh of the widget
                self._text_log.refresh()
                logger.debug(f"[UI] Refreshed RichLog widget after writing {len(self._formatted_messages)} messages")
            except Exception as write_err:
                logger.error(f"[UI] Error writing to RichLog: {str(write_err)}")
                logger.error(traceback.format_exc())
            
            # Ensure we scroll to the end
            try:
                self._text_log.scroll_end(animate=False)
                logger.debug("[UI] Scrolled to end of message log")
            except Exception as scroll_err:
                logger.error(f"[UI] Error scrolling: {str(scroll_err)}")
            
            # Force a refresh of the widget
            try:
                self.refresh()
                logger.debug("[UI] Refreshed MessageLog widget")
            except Exception as refresh_err:
                logger.error(f"[UI] Error refreshing widget: {str(refresh_err)}")
            
            logger.debug(f"[UI] _update_content completed. Total messages: {len(self.messages)}, "
                       f"Formatted messages: {len(self._formatted_messages)}")
                
        except Exception as e:
            logger.error(f"[UI] CRITICAL ERROR in _update_content: {str(e)}\n{traceback.format_exc()}")
            raise

    def clear_messages(self) -> None:
        """Clear all messages from the log."""
        self.messages = []
        self._formatted_messages = []
        if self._text_log:
            self._text_log.clear()
        
    def add_message(self, event: dict) -> None:
        """Add a message to the log."""
        try:
            # Always ensure we have a valid list for _formatted_messages
            # This is critical to prevent the 'bool' object has no attribute 'append' error
            if not hasattr(self, '_formatted_messages') or not isinstance(self._formatted_messages, list):
                logger.error(f"[UI] In add_message: _formatted_messages is missing or not a list: {getattr(self, '_formatted_messages', 'MISSING')}")
                # Create a new list and assign it directly to the instance
                object.__setattr__(self, '_formatted_messages', [])
                
            if not isinstance(event, dict):
                logger.warning(f"Expected dict, got {type(event).__name__}")
                event = {"type": "error", "content": f"Invalid message format: {event}"}
            
            # Ensure we have a valid message type
            if "type" not in event:
                event["type"] = "system"
                
            # Ensure we have content
            if "content" not in event:
                if "text" in event:
                    event["content"] = event["text"]
                else:
                    # Try to create content from other fields
                    content = ""
                    for field in ["message", "description", "output"]:
                        if field in event and event[field]:
                            content = str(event[field])
                            break
                    
                    if not content:
                        # Create content from all non-metadata fields
                        content = ", ".join(
                            f"{k}: {v}" for k, v in event.items() 
                            if k not in ["type", "timestamp"] and not k.startswith("_")
                        )
                    
                    event["content"] = content or "[No content]"
                
            # Ensure we have a timestamp
            if "timestamp" not in event:
                event["timestamp"] = datetime.now().isoformat()
            
            # Format the message immediately and cache it
            formatted = self._format_message(event)
            
            # Add to messages list (this will trigger watch_messages)
            current_messages = list(self.messages)  # Get current messages as list
            current_messages.append(event)  # Add new message
            self.messages = current_messages  # Trigger reactive update
            
            # Add to formatted messages if not a typing indicator
            if formatted:
                # Ensure _formatted_messages is a list before appending
                if not isinstance(self._formatted_messages, list):
                    logger.error(f"[UI] Before append: _formatted_messages is not a list: {type(self._formatted_messages)}")
                    object.__setattr__(self, '_formatted_messages', [])
                
                # Now append safely
                try:
                    self._formatted_messages.append(formatted)
                    logger.debug(f"[UI] Successfully appended to _formatted_messages (now length: {len(self._formatted_messages)})")
                except Exception as append_err:
                    logger.error(f"[UI] Error appending to _formatted_messages: {append_err}")
                    # Last resort: recreate the list with the new item
                    object.__setattr__(self, '_formatted_messages', list(getattr(self, '_formatted_messages', [])) + [formatted])
            
            msg_type = event.get("type", "unknown")
            content_preview = str(event.get("content", ""))[:100]
            logger.debug(f"Added message (type: {msg_type}): {content_preview}...")
            
        except Exception as e:
            logger.error(f"Error adding message: {e}", exc_info=True)
            # Add error to messages
            error_msg = {
                "type": "error",
                "content": f"Error displaying message: {str(e)}",
                "timestamp": datetime.now().isoformat()
            }
            self.messages = [*self.messages, error_msg]


class ChronicleApp(App):
    """Main Textual app for the Chronicle Engine."""
    TITLE = "Chronicle Engine - AI RPG"
    SUB_TITLE = "A text-based RPG powered by AI"
    
    CSS = """
    Screen {
        layout: vertical;
        overflow: hidden;
        padding: 0;
        margin: 0;
    }
    Header {
        height: 1;
        padding: 0 1;
    }
    #log-container {
        width: 100%;
        height: 1fr;
        padding: 0 1;
        overflow: hidden;
        border: round #00aa00;
        background: #000000; /* Black background for maximum contrast */
        color: #00ff00; /* Bright green text */
    }
    
    /* Force text visibility in RichLog */
    #log-content {
        color: #00ff00 !important;
        text-opacity: 1.0 !important;
        background: #000000 !important; /* Black background for maximum contrast */
    }
    #input-container {
        width: 100%;
        height: auto;
        padding: 1 2;
        background: $panel;
        border-top: solid $accent;
    }
    Input {
        width: 100%;
        height: 3;
        background: $surface;
        border: tall $accent;
        color: $text;
    }
    Input:focus {
        border: tall $accent-lighten-1;
    }
    """

    BINDINGS = [
        ("q", "quit", "Quit"),
        ("d", "toggle_developer", "Toggle Dev Mode (console log)"),
        ("x", "toggle_debug", "Toggle Debug Mode (no WebSocket)"),
    ]

    def __init__(self):
        super().__init__()
        self.websocket = None
        self.session_id = f"session_{hash(self):x}"
        self.scenario = "shadow_signal"
        self.developer_mode = False
        self.debug_mode = True  # Set to True to run without WebSocket connection
        self._composed = False
        logger.info(f"Initialized ChronicleApp with session_id: {self.session_id}")
        logger.info(f"Debug mode is {'ENABLED' if self.debug_mode else 'DISABLED'}")
        print(f"[DEBUG] Debug mode is {'ENABLED' if self.debug_mode else 'DISABLED'}")
        
        # Add initial welcome message
        self.initial_messages = [
            {"type": "system", "text": "Welcome to Chronicle Engine - Spy Console", "timestamp": datetime.now().isoformat()},
        ]

    def compose(self) -> ComposeResult:
        """Compose the main UI."""
        # Create the main layout
        yield Header()

        with Container(id="app-grid"):
            with Container(id="main-content"):
                # Message log container
                with Container(id="log-container"):
                    yield MessageLog()
                # Input container
                with Container(id="input-container"):
                    yield Input(placeholder="Type your action and press Enter...", id="user-input")

    async def on_mount(self) -> None:
        """Initialize the application when mounted."""
        # Add initial messages to the log
        message_log = self.query_one(MessageLog)
        for msg in self.initial_messages:
            message_log.add_message(msg)
                
        # Add system ready message
        message_log.add_message({
            "type": "system",
            "text": "System initialized and ready",
            "timestamp": datetime.now().isoformat()
        })
        
        # Skip WebSocket connection in debug mode
        if self.debug_mode:
            logger.info("Running in debug mode - skipping WebSocket connection")
            print("[DEBUG] Running in debug mode - skipping WebSocket connection")
            message_log.add_message({
                "type": "system",
                "text": "Running in debug mode - no WebSocket connection",
                "timestamp": datetime.now().isoformat()
            })
            # Add some test messages to verify UI display
            message_log.add_message({
                "type": "narrative",
                "text": "This is a test narrative message to verify text visibility in the UI.",
                "timestamp": datetime.now().isoformat()
            })
            message_log.add_message({
                "type": "choice",
                "options": ["Option 1: Test choice", "Option 2: Another test choice"],
                "timestamp": datetime.now().isoformat()
            })
            return
        
        # Connect to WebSocket if not in debug mode
        ws_url = f"ws://localhost:8000/ws/play?scenario={self.scenario}"
        logger.info(f"Attempting to connect to WebSocket: {ws_url}")
        
        try:
            # Connect with a reasonable timeout
            self.websocket = await asyncio.wait_for(
                websockets.connect(ws_url, ping_interval=20, ping_timeout=20),
                timeout=10.0
            )
            logger.info("WebSocket connection established successfully")
            
            # Start the message receiver
            asyncio.create_task(self.receive_messages())
            logger.debug("Started WebSocket message receiver task")
            
            # Send a test message to verify the connection
            try:
                test_msg = {"type": "ping", "text": "Frontend connected", "timestamp": datetime.now().isoformat()}
                await self.websocket.send(json.dumps(test_msg))
                logger.debug("Sent test ping message to WebSocket")
            except Exception as e:
                logger.error(f"Error sending test message: {e}", exc_info=True)
            
        except asyncio.TimeoutError:
            error_msg = "Connection timed out. Is the backend server running?"
            logger.error(error_msg)
            self.query_one(MessageLog).add_message({"type": "error", "text": error_msg})
            
        except websockets.exceptions.InvalidURI as e:
            error_msg = f"Invalid WebSocket URL: {ws_url} - {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.query_one(MessageLog).add_message({"type": "error", "text": error_msg})
            
        except ConnectionRefusedError:
            error_msg = "Connection refused. Is the backend server running on port 8000?"
            logger.error(error_msg)
            self.query_one(MessageLog).add_message({"type": "error", "text": error_msg})
            
        except Exception as e:
            error_msg = f"Failed to connect: {str(e)}. Is the backend running?"
            logger.error(error_msg, exc_info=True)
            self.query_one(MessageLog).add_message({"type": "error", "text": error_msg})

    async def receive_messages(self):
        """Listen for incoming WebSocket messages."""
        if not self.websocket or getattr(self.websocket, 'closed', True):
            logger.error("WebSocket connection not established")
            self.query_one(MessageLog).add_message({
                "type": "error",
                "content": "WebSocket connection not properly initialized. Please restart the application."
            })
            return
            
        logger.info("Starting WebSocket message receiver")
        
        try:
            while True:
                try:
                    logger.debug("Awaiting WebSocket messages...")
                    message = await self.websocket.recv()
                    
                    if not message:
                        logger.warning("Received empty message from WebSocket")
                        continue
                        
                    # Log the message (truncate if too long)
                    msg_str = str(message)
                    logger.debug(f"Received WebSocket message: {msg_str[:200]}{'...' if len(msg_str) > 200 else ''}")
                    
                    try:
                        # Parse the JSON message
                        event = json.loads(message)
                        
                        # Log the parsed event (safely handle non-dict events)
                        if isinstance(event, dict):
                            msg_type = event.get('type', 'unknown')
                            logger.debug(f"Processing WebSocket message of type: {msg_type}")
                            
                            # Special handling for error messages
                            if msg_type == 'error':
                                error_content = event.get('content', 'Unknown error')
                                logger.error(f"Server error: {error_content}")
                        
                        # Add the message to the UI
                        message_log = self.query_one(MessageLog)
                        if message_log:
                            message_log.add_message(event)
                        else:
                            logger.error("MessageLog widget not found in the UI")
                        
                    except json.JSONDecodeError as je:
                        error_msg = f"Invalid message format: {str(je)}"
                        logger.error(f"{error_msg}\nMessage: {message[:200]}...")
                        self.query_one(MessageLog).add_message({
                            "type": "error",
                            "content": error_msg
                        })
                        
                except websockets.exceptions.ConnectionClosed as ce:
                    logger.info(f"WebSocket connection closed: {ce}")
                    self.query_one(MessageLog).add_message({
                        "type": "system",
                        "content": "Disconnected from server. Please refresh to reconnect."
                    })
                    break
                    
                except asyncio.CancelledError:
                    logger.info("WebSocket listener was cancelled")
                    break
                    
                except Exception as e:
                    error_msg = f"Error processing message: {str(e)}"
                    logger.error(error_msg, exc_info=True)
                    self.query_one(MessageLog).add_message({
                        "type": "error",
                        "content": error_msg
                    })
                    # Add a small delay to prevent tight error loops
                    await asyncio.sleep(1)
                    
            logger.info("WebSocket message receiver stopped")
            
        except Exception as e:
            logger.error(f"Fatal error in WebSocket receiver: {e}", exc_info=True)
            self.query_one(MessageLog).add_message({
                "type": "error",
                "content": f"Connection error: {str(e)}"
            })

    async def handle_input_submitted(self, event: Input.Submitted) -> None:
        """Send user input to the backend or handle in debug mode."""
        user_input = event.input.value.strip()
        if not user_input:
            logger.debug("Ignoring empty input submission")
            return
            
        logger.info(f"User input: {user_input}")
        
        # Add user message to the log
        message_log = self.query_one(MessageLog)
        message_log.add_message({
            "type": "user",
            "content": user_input,
            "timestamp": datetime.now().isoformat()
        })
        
        # Handle input in debug mode without WebSocket
        if self.debug_mode:
            logger.debug("Processing input in debug mode")
            # Generate a simple response based on input
            if user_input.lower() in ["help", "?"]:  
                message_log.add_message({
                    "type": "system",
                    "text": "Debug Mode Help: Type any text to see it displayed. Special commands: 'quit', 'exit', 'clear'.",
                    "timestamp": datetime.now().isoformat()
                })
            elif user_input.lower() in ["quit", "exit"]:
                self.exit()
            elif user_input.lower() == "clear":
                message_log.messages = []
                message_log.add_message({
                    "type": "system",
                    "text": "Message log cleared",
                    "timestamp": datetime.now().isoformat()
                })
            else:
                # Echo back a narrative response
                message_log.add_message({
                    "type": "narrative",
                    "text": f"You entered: {user_input}",
                    "timestamp": datetime.now().isoformat()
                })
                # Add a choice response for testing
                message_log.add_message({
                    "type": "choice",
                    "options": [f"Continue with '{user_input}'?", "Try something else"],
                    "timestamp": datetime.now().isoformat()
                })
            return
        
        # Send to WebSocket if connected and not in debug mode
        if self.websocket and not self.websocket.closed:
            message = {
                "type": "user_input",
                "content": user_input,
                "timestamp": datetime.now().isoformat()
            }
            logger.debug(f"Sending message to WebSocket: {message}")
            
            try:
                await self.websocket.send(json.dumps(message))
                logger.debug("Successfully sent message to WebSocket")
            except websockets.exceptions.ConnectionClosed as ce:
                error_msg = f"WebSocket connection closed while sending: {ce}"
                logger.error(error_msg)
                message_log.add_message({
                    "type": "error",
                    "text": "Connection lost. Please restart the application."
                })
            except Exception as e:
                error_msg = f"Error sending message: {str(e)}"
                logger.error(error_msg, exc_info=True)
                message_log.add_message({
                    "type": "error",
                    "text": f"Failed to send message: {str(e)}"
                })
        else:
            error_msg = "Not connected to WebSocket. Cannot send message."
            logger.error(error_msg)
            message_log.add_message({
                "type": "error",
                "text": "Not connected to the game server. Please check your connection."
            })
        
        # Clear the input
        event.input.value = ""
        logger.debug("Cleared input field after submission")

    def action_toggle_developer(self) -> None:
        """Toggle developer mode (prints raw JSON to console)."""
        self.developer_mode = not self.developer_mode
        status = "enabled" if self.developer_mode else "disabled"
        logger.info(f"Developer mode {status}")
        self.query_one(MessageLog).add_message({
            "type": "system",
            "text": f"Developer mode {status}",
            "timestamp": datetime.now().isoformat()
        })
        
    def action_toggle_debug(self) -> None:
        """Toggle debug mode (runs without WebSocket connection)."""
        self.debug_mode = not self.debug_mode
        status = "enabled" if self.debug_mode else "disabled"
        logger.info(f"Debug mode {status}")
        
        message_log = self.query_one(MessageLog)
        message_log.add_message({
            "type": "system",
            "text": f"Debug mode {status}",
            "timestamp": datetime.now().isoformat()
        })
        
        # If turning debug mode off, try to connect to WebSocket
        # If turning debug mode on, disconnect from WebSocket
        if not self.debug_mode and not self.websocket:
            message_log.add_message({
                "type": "system",
                "text": "Attempting to connect to WebSocket...",
                "timestamp": datetime.now().isoformat()
            })
            # Schedule connection attempt
            asyncio.create_task(self._connect_websocket())
        elif self.debug_mode and self.websocket:
            message_log.add_message({
                "type": "system",
                "text": "Disconnecting from WebSocket...",
                "timestamp": datetime.now().isoformat()
            })
            # Schedule disconnection
            asyncio.create_task(self._disconnect_websocket())

    async def _connect_websocket(self) -> None:
        """Helper method to connect to WebSocket."""
        message_log = self.query_one(MessageLog)
        ws_url = f"ws://localhost:8000/ws/play?scenario={self.scenario}"
        logger.info(f"Attempting to connect to WebSocket: {ws_url}")
        
        try:
            # Connect with a reasonable timeout
            self.websocket = await asyncio.wait_for(
                websockets.connect(ws_url, ping_interval=20, ping_timeout=20),
                timeout=10.0
            )
            logger.info("WebSocket connection established successfully")
            message_log.add_message({
                "type": "system",
                "text": "Connected to game server",
                "timestamp": datetime.now().isoformat()
            })
            
            # Start the message receiver
            asyncio.create_task(self.receive_messages())
            logger.debug("Started WebSocket message receiver task")
            
        except (asyncio.TimeoutError, ConnectionRefusedError) as e:
            error_msg = f"Connection failed: {str(e)}. Is the backend server running?"
            logger.error(error_msg)
            message_log.add_message({"type": "error", "text": error_msg})
            # Re-enable debug mode since connection failed
            self.debug_mode = True
            message_log.add_message({
                "type": "system",
                "text": "Debug mode re-enabled due to connection failure",
                "timestamp": datetime.now().isoformat()
            })
        except Exception as e:
            error_msg = f"Unexpected error connecting: {str(e)}"
            logger.error(error_msg, exc_info=True)
            message_log.add_message({"type": "error", "text": error_msg})
            # Re-enable debug mode since connection failed
            self.debug_mode = True
            message_log.add_message({
                "type": "system",
                "text": "Debug mode re-enabled due to connection failure",
                "timestamp": datetime.now().isoformat()
            })
    
    async def _disconnect_websocket(self) -> None:
        """Helper method to disconnect from WebSocket."""
        if not self.websocket:
            return
            
        try:
            await self.websocket.close()
            logger.info("WebSocket connection closed")
            self.websocket = None
            self.query_one(MessageLog).add_message({
                "type": "system",
                "text": "Disconnected from game server",
                "timestamp": datetime.now().isoformat()
            })
        except Exception as e:
            logger.error(f"Error closing WebSocket: {e}", exc_info=True)
            self.websocket = None


if __name__ == "__main__":
    app = ChronicleApp()
    app.run()