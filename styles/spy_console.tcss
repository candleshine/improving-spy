/* Color variables */
$background: #0a0e14;
$foreground: #b3b1ad;
$primary: #39BAE6;
$secondary: #59C2FF;
$accent: #FF8F40;
$error: #FF3333;
$success: #86B300;
$warning: #FA8D3E;

/* Main screen styling */
Screen {
    background: $background;
    color: $foreground;
}

/* Main application screen */
#main-screen {
    layout: vertical;
}

/* Spy selector */
SpySelector {
    height: 3;
    dock: top;
    padding: 0 1;
    background: $background;
    border-bottom: solid $primary;
}

SpySelector Label {
    width: auto;
    padding: 1 2;
    color: $foreground;
}

SpySelector Select {
    width: 1fr;
}

SpySelector Button {
    width: 15;
}

/* Chat window */
ChatWindow {
    height: 1fr;
    border: solid $primary;
    padding: 1;
    background: $background;
}

ChatWindow > Static {
    margin-bottom: 1;
}

/* Input bar */
InputBar {
    height: 3;
    dock: bottom;
    padding: 0 1;
    background: $background;
    border-top: solid $primary;
}

InputBar Input {
    width: 1fr;
    margin-right: 1;
}

InputBar Button {
    width: 10;
}

InputBar.disabled {
    opacity: 0.5;
}

/* Status bar */
#status-bar {
    height: 1;
    dock: bottom;
    background: $primary 20%;
    color: $foreground;
    padding: 0 1;
}
